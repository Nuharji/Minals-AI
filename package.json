{
  "name": "minals",
  "productName": "Minals",
  "version": "0.1.0",
  "description": "Ein lokal laufender, Jarvis-artiger Sprachassistent fuer Linux (powered by Ollama)",
  "main": "src/main/index.js",
  "author": "Minals Project",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "ELECTRON_ENABLE_LOGGING=1 electron .",
    "build:linux": "electron-builder --linux",
    "build:flatpak": "electron-builder --linux flatpak"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.minals.Minals",
    "productName": "Minals",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png",
      "target": [
        "flatpak"
      ]
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "23.08",
      "baseVersion": "23.08",
      "sdk": "org.freedesktop.Sdk",
      "finishArgs": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--share=network",
        "--device=dri",
        "--filesystem=xdg-documents",
        "--filesystem=xdg-download",
        "--talk-name=org.freedesktop.Notifications"
      ]
    }
  }
}
